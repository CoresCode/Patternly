{
  "name": "patternly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/data.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:cloudflare": "npm run build -- --base=/",
